# Copy to .env on the VPS and fill in values.

DOCKERHUB_USERNAME=yourdockerhubusername

# Host ports (optional)
BACKEND_PORT=5000
FRONTEND_PORT=80

# Backend (same variables as fin_backend expects — see fin_backend index.js)
MONGO_URI=
JWT_SECRET=
EMAIL_USER=
EMAIL_PASS=
PORT=5000

# Add any other env vars your backend uses (AWS, etc.)
